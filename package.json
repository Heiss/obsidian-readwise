{
  "name": "obsidian-readwise",
  "version": "0.1.0",
  "description": "The Readwise Reader plugin for Obsidian: link your saved documents, save URLs to Reader, show highlights beside your notes, and insert them as quotes.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": ["obsidian", "readwise", "reader", "highlights"],
  "author": "Peter Heiss",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@typescript-eslint/parser": "^8.65.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.7.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.65.0",
    "vitest": "^2.1.0"
  }
}
